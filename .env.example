# ─────────────────────────────────────────────────────────────────────────────
# FACTORY · environment configuration
# Copy to apps/api/.env (API) and apps/web/.env.local (web). Never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
WEB_ORIGIN=http://localhost:3000

# --- database & cache ------------------------------------------------------
# Local default (SQLite) needs zero infrastructure. For Docker/Postgres:
# DATABASE_URL=postgresql+asyncpg://factory:factory_dev_password@localhost:5432/factory
DATABASE_URL=sqlite+aiosqlite:///./factory.db
REDIS_URL=redis://localhost:6379/0

# --- auth ------------------------------------------------------------------
# Generate a strong value: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32-chars
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@factory.app
BOOTSTRAP_ADMIN_PASSWORD=factory-admin-2026
BOOTSTRAP_ADMIN_NAME=Operator

# --- credential encryption -------------------------------------------------
# AES-256-GCM master key for provider credentials (64 hex chars or 32 base64 bytes).
# Generate once:  python -m app.cli gen-key
# Without it the API refuses to store or read keys — it never falls back to plaintext.
APP_ENCRYPTION_KEY=
# Legacy alias, only read when APP_ENCRYPTION_KEY is empty (keeps old ciphertexts readable).
CREDENTIAL_KEY=

# --- storage ---------------------------------------------------------------
STORAGE_BACKEND=local            # local | r2
STORAGE_ROOT=./storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- video engine (Remotion) -----------------------------------------------
# Remotion is the only composition/render engine. FFmpeg ships with Remotion internally; no
# separate FFmpeg pipeline is used. ffprobe is used read-only to inspect finished files.
# Node 18+ and `npm install` inside services/media-engine/remotion are required.
REMOTION_DIR=                    # default: <repo>/services/media-engine/remotion
NODE_PATH=node
REMOTION_CONCURRENCY=0           # 0 = let Remotion pick (half the CPU threads)
REMOTION_GL=angle                # angle | swangle | swiftshader | egl
REMOTION_CRF=20
REMOTION_JPEG_QUALITY=90
REMOTION_RENDER_TIMEOUT_S=1800
# Commercial use: Remotion needs a Company Licence for companies >3 people.
# https://www.remotion.dev/docs/license
REMOTION_LICENSE_KEY=
REMOTION_LICENSE_ACKNOWLEDGED=false

# --- render queue -----------------------------------------------------------
RENDER_IN_API=true               # false = render only in `python -m app.worker`
RENDER_CONCURRENCY=1
RENDER_MAX_ATTEMPTS=2
RENDER_CROSS_PROCESS_POLL=true   # also claim jobs queued by another process

# --- providers (optional bootstrap defaults; prefer configuring in the UI) --
DEFAULT_LLM_PROVIDER=mock        # mock | openai | gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# --- workflow --------------------------------------------------------------
WORKFLOW_BACKEND=local           # local | temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=factory-production
MAX_CONCURRENT_WORKFLOWS=3
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30

# --- media -----------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_MODEL=base

# --- YouTube OAuth ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:8000/api/v1/youtube/callback

# --- limits ----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=240

# --- docker compose only ---------------------------------------------------
POSTGRES_USER=factory
POSTGRES_PASSWORD=factory_dev_password
POSTGRES_DB=factory
